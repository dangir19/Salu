# Copy to .env or .dev.vars. None of these are required to compile, lint, or test.
# Native email/password accounts need no extra keys. AUTH_SECRET still signs the JWT.
# Google / Apple are optional shortcuts once their apps exist.

AUTH_SECRET=salu-dev-auth-secret-not-for-production-32b
AUTH_URL=http://localhost:5173

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple Developer → Identifiers → Services ID + Sign in with Apple key
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Or generate AUTH_APPLE_SECRET at runtime from:
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=

# Optional: Google/Apple emails that open the provider workspace (comma-separated).
# Demo Tide & Tone emails (tide@localhost) do not need this. See PROVIDER.md.
SALU_PROVIDER_EMAILS=

# Stripe Billing — see STRIPE.md. Not required to compile, lint, or test.
# Sign into https://dashboard.stripe.com to create products, prices, and the webhook.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GOLD_PRICE_ID=
STRIPE_PLATINUM_PRICE_ID=
# Optional. Express Account Links only need STRIPE_SECRET_KEY. See CONNECT.md.
STRIPE_CONNECT_CLIENT_ID=

# Optional. When set, /admin application list + status need the x-salu-ops header.
# Not required to compile, lint, or test.
SALU_OPS_SECRET=

# Optional Atlas language model. Without this key, Atlas stays on the
# deterministic planner and still books through /api/bookings when signed in.
OPENAI_API_KEY=
OPENAI_MODEL=
